{
  "name": "idealista",
  "version": "1.0.0",
  "description": "Idealista apartment tracker with Notion integration",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build:app": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack": "electron-vite build && electron-builder",
    "scrape": "tsx src/index.ts",
    "build": "tsc",
    "init:browser": "tsx src/init-browser.ts",
    "init:browser:dist": "node dist/init-browser.js",
    "scrape:dist": "node dist/index.js",
    "package:portable": "npm run build && node scripts/build-portable.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^17.4.1",
    "grammy": "^1.42.0",
    "playwright": "^1.59.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.8"
  }
}
