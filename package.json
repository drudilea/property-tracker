{
  "name": "idealista",
  "version": "1.0.0",
  "description": "Idealista apartment tracker with Notion integration",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "init:browser": "tsx src/init-browser.ts",
    "scrape": "tsx src/index.ts",
    "bot": "tsx src/bot.ts",
    "init:browser:dist": "node dist/init-browser.js",
    "scrape:dist": "node dist/index.js",
    "bot:dist": "node dist/bot.js",
    "package:portable": "npm run build && node scripts/build-portable.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^17.4.1",
    "grammy": "^1.42.0",
    "playwright": "^1.59.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
